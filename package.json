{
  "name": "fast-jev-compaction",
  "version": "0.2.0",
  "description": "Continuous, verbatim context compaction for LLM agents using TypeSafe's Jev model.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.12.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": "./opencode/index.ts"
  },
  "files": [
    "dist",
    "opencode",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "compile": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks && npm run typecheck:opencode",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "benchmark:opencode": "tsx examples/benchmark-opencode.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json",
    "typecheck:opencode": "tsc -p tsconfig.opencode.json"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.24",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliowap/opencode-fast-Jev-compaction.git"
  }
}
